{
  "name": "belflow-protocol",
  "private": true,
  "description": "Confidential payroll, selective compliance receipts and x402 AI payment rails on Beldex.",
  "license": "MIT",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@belflow/web",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:testnet": "pnpm --filter @belflow/sdk test:testnet",
    "e2e": "pnpm --filter @belflow/web e2e",
    "db:push": "pnpm --filter @belflow/web db:push",
    "db:generate": "pnpm --filter @belflow/web db:generate",
    "test:audit": "turbo run test:audit",
    "testnet:deploy": "pnpm --filter @belflow/web testnet:deploy",
    "report:qa": "pnpm --filter @belflow/web report:qa"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  }
}
