{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "BELDEX_*",
    "BELFLOW_*",
    "DATABASE_URL",
    "SESSION_SECRET",
    "TREASURY_OPERATOR_ADDRESS"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {},
    "test": {
      "outputs": []
    },
    "test:coverage": {
      "outputs": [
        "coverage/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:audit": {
      "outputs": []
    }
  }
}
