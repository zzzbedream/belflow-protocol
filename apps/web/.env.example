# ---------------------------------------------------------------------------
# BelFlow web app configuration. Copy to apps/web/.env and adjust.
# ---------------------------------------------------------------------------

# SQLite for local development (path is relative to prisma/schema.prisma).
DATABASE_URL="file:./belflow.db"

# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
SESSION_SECRET=""

# Public origin used in signed login statements (no trailing slash).
BELFLOW_PUBLIC_ORIGIN="http://localhost:3000"

# Header your reverse proxy sets with the real client IP (e.g. "x-real-ip").
# Leave empty to use the last X-Forwarded-For hop. Used for rate limiting.
BELFLOW_TRUSTED_IP_HEADER=""

# Deterministic mock chain (always available).
BELFLOW_MOCK_SEED="belflow-mock-devnet"
BELFLOW_MOCK_STATE_FILE=".data/mock-chain.json"
# "file" (default locally) or "db": keep the mock ledger in the database so
# serverless instances share it (default when VERCEL=1). See docs/DEPLOY_VERCEL.md.
BELFLOW_MOCK_STATE_STORE="file"

# --- Beldex Testnet (Proto) -------------------------------------------------
# beldexd testnet JSON-RPC (optional; the public explorer is used for tx inspection otherwise)
BELDEX_DAEMON_RPC_URL=""
# beldex-wallet-rpc built from Beldex-Coin/beldex@feature-privacy-token
BELDEX_WALLET_RPC_URL=""
BELDEX_WALLET_RPC_USER=""
BELDEX_WALLET_RPC_PASSWORD=""
BELDEX_EXPLORER_API_URL="https://testnet.beldex.dev/api"

# Treasury actions (payroll, token deploy, proofs) on testnet require a login
# whose wallet address equals this value.
BELFLOW_TREASURY_ENABLED="false"
TREASURY_OPERATOR_ADDRESS=""

# x402 demo resource pricing
X402_PRICE="0.50"
X402_TOKEN_TICKER="bUSD"
X402_RECIPIENT_BNS="oracle-provider.bdx"
