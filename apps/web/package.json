{
  "name": "@belflow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-schema.mjs generate && next build",
    "start": "next start",
    "lint": "node --max-old-space-size=4096 ./node_modules/eslint/bin/eslint.js src",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "db:push": "prisma db push",
    "db:generate": "node scripts/prisma-schema.mjs generate",
    "db:postgres-schema": "node scripts/prisma-schema.mjs write",
    "test:audit": "vitest run --config vitest.audit.config.ts",
    "testnet:deploy": "tsx scripts/testnet-deploy-and-seed.ts",
    "report:qa": "tsx scripts/generate-qa-report.ts"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "dependencies": {
    "@belflow/sdk": "workspace:*",
    "@belflow/x402": "workspace:*",
    "@prisma/client": "6.19.3",
    "animejs": "4.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jose": "6.2.12",
    "lucide-react": "1.57.0",
    "next": "15.5.28",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "fast-check": "4.10.2",
    "postcss": "8.5.30",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
